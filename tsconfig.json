{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": [
      "ES2020"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "tests"
  ],
  "exclude": [
    "src/ui",
    "src/navigation",
    "src/screens",
    "src/i18n",
    "App.tsx",
    "index.ts"
  ]
}
