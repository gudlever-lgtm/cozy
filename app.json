{
  "expo": {
    "name": "Cozy Solitaire",
    "slug": "games",
    "owner": "osomanden",
    "scheme": "cozysolitaire",
    "version": "2.1.1",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f2e8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gudlever.cozy",
      "buildNumber": "30",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarHidden": true
      }
    },
    "android": {
      "package": "com.gudlever.cozy",
      "versionCode": 30,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f6f2e8"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "behavior": "overlay-swipe"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "platforms": [
      "ios",
      "android"
    ],
    "androidStatusBar": {
      "hidden": true
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "backgroundColor": "#254b3a"
    },
    "extra": {
      "eas": {
        "projectId": "8abb2d87-01df-4afc-8c5a-42557ac01b06"
      }
    }
  }
}
